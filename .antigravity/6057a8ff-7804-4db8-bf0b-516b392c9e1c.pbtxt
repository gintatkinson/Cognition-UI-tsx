          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              if (durUnit === \'seconds32\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                return `Human Equivalent: ${(v/3600).toFixed(2)} hours (or ${(v/60).toFixed(1)} minutes)`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              } else if (durUnit === \'nanoseconds32\' || durUnit === \'nanoseconds64\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                return `Human Equivalent: ${(v/1e9).toFixed(5)} seconds`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              } else if (durUnit === \'milliseconds32\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                return `Human Equivalent: ${(v/1000).toFixed(3)} seconds`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              return \"Equivalent unit: standard Gregorian intervals\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            })()}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

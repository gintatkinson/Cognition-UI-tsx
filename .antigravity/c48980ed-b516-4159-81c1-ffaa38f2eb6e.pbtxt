    source_trajectory_step_info {
      trajectory_id: "c48980ed-b516-4159-81c1-ffaa38f2eb6e"
      step_index: 177
      metadata_index: 312
      cascade_id: "c48980ed-b516-4159-81c1-ffaa38f2eb6e"
